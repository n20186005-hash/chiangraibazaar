---
import '../styles/global.css';
import { siteConfig } from '../config';
import { htmlLang, languagesList, type Lang } from '../i18n/ui';
import thMessages from '../i18n/th.json';
import enMessages from '../i18n/en.json';
import zhMessages from '../i18n/zh.json';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Set true on auxiliary pages (legal/tool pages) to keep them out of search indexes. */
  noindex?: boolean;
  guidePage?: boolean;
}
const { lang, title, description, noindex = false, guidePage = false } = Astro.props;

// Canonical URL follows the site-wide convention:
// language roots keep a trailing slash (/en/), deeper pages do not (/en/privacy-policy).
const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isLangRoot = /^\/(th|en|zh)$/.test(rawPath);
const canonicalPath = isLangRoot ? `${rawPath}/` : rawPath;
const canonical = `${siteConfig.domain}${canonicalPath}`;

const messagesMap: Record<Lang, any> = { th: thMessages, en: enMessages, zh: zhMessages };
const faqs: { q: string; a: string }[] = messagesMap[lang].guide.faqs;
const heroImageAlt: string = messagesMap[lang].hero.imgAlt;

const heroImage = `${siteConfig.domain}/gallery/chiang-rai-night-bazaar-1.jpg`;

const jsonLd = guidePage ? [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: htmlLang[lang],
  mainEntityOfPage: canonical,
  publisher: { '@type': 'Organization', name: 'Chiang Rai Night Bazaar Guide' },
}] : [
  {
    '@context': 'https://schema.org',
    '@type': ['TouristAttraction', 'NightMarket'],
    '@id': `${siteConfig.domain}/#attraction`,
    name: siteConfig.name[lang],
    alternateName: [
      siteConfig.name.en,
      siteConfig.name.th,
      siteConfig.name.zh,
      `Chiang Rai ${siteConfig.name.en}`,
    ],
    description,
    image: [
      heroImage,
      `${siteConfig.domain}/gallery/chiang-rai-night-bazaar-8.jpg`,
    ],
    url: canonical,
    isAccessibleForFree: true,
    hasMap: siteConfig.mapsUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.address[lang],
      addressLocality: 'Chiang Rai',
      addressRegion: 'Chiang Rai Province',
      postalCode: '57000',
      addressCountry: 'TH',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: siteConfig.coords.lat,
      longitude: siteConfig.coords.lng,
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: siteConfig.rating,
      reviewCount: siteConfig.reviewCount.replace(/,/g, ''),
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '18:30',
        closes: '23:00',
      },
    ],
    sameAs: [...siteConfig.sameAs, siteConfig.govtTourismUrl],
    publicAccess: true,
    touristType: 'Leisure, Shopping, Food',
    openingHours: 'Mo-Su 18:30-23:00',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={`/gallery/chiang-rai-night-bazaar-1.jpg`} />
    <link rel="apple-touch-icon" href={`/gallery/chiang-rai-night-bazaar-1.jpg`} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#071a1c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteConfig.domain}/gallery/chiang-rai-night-bazaar-1.jpg`} />
    <meta property="og:image:alt" content={heroImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {languagesList.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={`${siteConfig.domain}/${l}${rawPath.split('/').slice(2).length ? `/${rawPath.split('/').slice(2).join('/')}` : '/'}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteConfig.domain}/en${rawPath.split('/').slice(2).length ? `/${rawPath.split('/').slice(2).join('/')}` : '/'}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=Trirong:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Sarabun:wght@300;400;500;600;700&family=Charm:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="grain">
    <slot />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
