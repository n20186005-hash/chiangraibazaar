---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const s = messages.seasonal;
---

<section id="seasonal" class="py-20 bg-teak text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-3xl text-ivory/80">{s.lead}</p>

    <div class="mt-10 overflow-x-auto rounded-2xl border border-gold/25">
      <table class="w-full text-sm min-w-[760px]">
        <thead>
          <tr class="bg-teakDeep text-goldBright text-left">
            <th class="px-5 py-4 font-semibold">{s.cols.season}</th>
            <th class="px-5 py-4 font-semibold">{s.cols.climate}</th>
            <th class="px-5 py-4 font-semibold">{s.cols.crowd}</th>
            <th class="px-5 py-4 font-semibold">{s.cols.strategy}</th>
            <th class="px-5 py-4 font-semibold">{s.cols.rating}</th>
          </tr>
        </thead>
        <tbody>
          {s.rows.map((row: any, i: number) => (
            <tr class={`align-top ${i % 2 === 0 ? 'bg-ivory/5' : 'bg-ivory/10'} border-t border-gold/15`}>
              <td class="px-5 py-4 font-semibold text-goldBright whitespace-nowrap">{row.season}</td>
              <td class="px-5 py-4 text-ivory/85">{row.climate}</td>
              <td class="px-5 py-4 text-ivory/85">{row.crowd}</td>
              <td class="px-5 py-4 text-ivory/85">{row.strategy}</td>
              <td class="px-5 py-4 text-goldBright whitespace-nowrap">{row.rating}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-xs text-ivory/50">{s.sourceNote}</p>
  </div>
</section>
