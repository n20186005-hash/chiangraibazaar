---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const sv = messages.services;
---

<section id="services" class="py-20 bg-teak text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{sv.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl mt-2">{sv.heading}</h2>
    <p class="mt-4 max-w-3xl text-ivory/80">{sv.lead}</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
      {sv.items.map((item: any) => (
        <div class="rounded-2xl border border-gold/25 bg-teakDeep/60 p-5 flex gap-4">
          <span class="text-2xl leading-none mt-1">{item.icon}</span>
          <div>
            <div class="font-semibold text-goldBright">{item.title}</div>
            <p class="text-sm text-ivory/80 mt-1.5 leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-6 text-xs text-ivory/50">{sv.neutralNote}</p>
  </div>
</section>
