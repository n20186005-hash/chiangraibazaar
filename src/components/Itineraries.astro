---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const it = messages.itineraries;
---

<section id="itineraries" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{it.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{it.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{it.lead}</p>

    <!-- General routes: half-day / full-day -->
    <div class="grid lg:grid-cols-2 gap-8 mt-10">
      {[it.halfDay, it.fullDay].map((route: any) => (
        <div class="rounded-2xl border border-gold/30 bg-white/50 p-6">
          <span class="chip text-teak border-gold/40">{route.tag}</span>
          <ol class="mt-5 space-y-4">
            {route.steps.map((step: any, i: number) => (
              <li class="flex gap-4">
                <span class="font-display text-gold text-lg min-w-[4.5rem] text-right">{step.time}</span>
                <div class="flex-1 border-l border-gold/30 pl-4">
                  <p class="text-ink/90">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>

    <!-- Audience-tailored routes -->
    <h3 class="font-display font-semibold text-2xl md:text-3xl text-teak mt-16">{it.audienceTitle}</h3>
    <div class="grid lg:grid-cols-3 gap-8 mt-8">
      {it.audiences.map((a: any) => (
        <div class="rounded-2xl bg-teak text-ivory p-6 flex flex-col">
          <span class="font-hand text-gold text-xl">{a.tag}</span>
          <div class="font-display text-xl font-semibold mt-1">{a.title}</div>
          <p class="text-ivory/80 text-sm mt-3">{a.desc}</p>
          <ul class="mt-4 space-y-2 text-sm text-ivory/85 flex-1">
            {a.points.map((p: string) => (
              <li class="flex gap-2"><span class="text-gold">·</span><span>{p}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
