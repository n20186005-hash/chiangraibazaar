---
import { guides } from '../data/guides';
import type { Lang } from '../i18n/ui';
const {lang} = Astro.props as {lang:Lang};
const heading = {en:'More Chiang Rai guides',zh:'更多清莱旅游攻略',th:'คู่มือเที่ยวเชียงรายเพิ่มเติม'}[lang];
const intro = {en:'Explore food, shopping, routes and nearby sights in 30 dedicated guides.',zh:'探索30篇独立的美食、购物、路线与周边景点攻略。',th:'อ่านคู่มือ 30 เรื่องเกี่ยวกับอาหาร ช้อปปิ้ง เส้นทาง และสถานที่ใกล้เคียง'}[lang];
---
<section id="more-guides" class="bg-ivory py-16 border-t border-gold/30"><div class="max-w-7xl mx-auto px-5"><h2 class="font-display text-3xl md:text-4xl">{heading}</h2><p class="text-ink/70 mt-3 mb-8">{intro}</p><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">{guides.slice(0,9).map(g=><a href={`/${lang}/guides/${g.slug}/`} class="rounded-lg bg-white border border-gold/30 p-5 hover:shadow-md transition-shadow"><h3 class="font-semibold">{g.copy[lang][0]}</h3><p class="text-sm mt-2 text-ink/70">{g.copy[lang][1]}</p></a>)}</div><a href={`/${lang}/guides/`} class="inline-flex mt-8 bg-teak text-goldBright px-6 py-3 rounded-full">{lang==='zh'?'查看全部30篇攻略 →':lang==='th'?'ดูคู่มือทั้ง 30 เรื่อง →':'Browse all 30 guides →'}</a></div></section>
