---
import type { Lang } from '../i18n/ui';
import {
  getWeather,
  buildAdvice,
  weatherCategory,
  uvLevel,
  windLevel,
} from '../lib/weather';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const w = messages.weather;
const data = await getWeather();
const advice = data ? buildAdvice(data) : null;

const locales: Record<Lang, string> = { th: 'th-TH', en: 'en-US', zh: 'zh-CN' };

const codeLabel = (code: number) => w.codes[weatherCategory(code)];
const codeIcon = (code: number) =>
  ({
    clear: '☀️', partlyCloudy: '🌤️', cloudy: '☁️', fog: '🌫️',
    drizzle: '🌦️', rain: '🌧️', shower: '🌦️', snow: '❄️', thunder: '⛈️',
  })[weatherCategory(code)];

const weekdayFmt = new Intl.DateTimeFormat(locales[lang], { weekday: 'short' });
const dateFmt = new Intl.DateTimeFormat(locales[lang], { day: 'numeric', month: 'short' });
const timeFmt = new Intl.DateTimeFormat(locales[lang], { hour: '2-digit', minute: '2-digit', hour12: false });
const toDate = (dateStr: string) => new Date(`${dateStr}T12:00:00+07:00`);

// Plain-language summary line: "Sunny · 24–33°C · Strong sun · Light breeze"
const today = data?.daily[0];
const summaryParts = data
  ? [
      `${codeLabel(data.current.weatherCode)}`,
      today ? `${Math.round(today.tempMin)}–${Math.round(today.tempMax)}°C` : `${Math.round(data.current.temperature)}°C`,
      w.advice.uv[uvLevel(today?.uvIndexMax ?? data.current.uvIndex)],
      w.advice.wind[windLevel(data.current.windSpeed)],
    ]
  : [];

const updated = data ? timeFmt.format(new Date(data.fetchedAt)) : null;

const groupIcons: Record<string, string> = { outfit: '👕', activity: '🗓️', items: '🎒' };
const groupKeys = ['outfit', 'activity', 'items'] as const;
const hasAnyGroup = advice ? groupKeys.some((g) => advice[g].length > 0) : false;
---

<section id="weather" class="py-20 bg-teak text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{w.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl mt-2">{w.heading}</h2>
    <p class="mt-4 max-w-2xl text-ivory/80">{w.lead}</p>

    {data && advice ? (
      <div class="grid lg:grid-cols-12 gap-8 mt-10">
        <!-- Base weather card: temperature, condition, rain chance, wind -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-teakDeep/70 border border-gold/25 p-6 h-full">
            <div class="flex items-center justify-between">
              <span class="text-sm text-ivory/70">{w.currentLabel}</span>
              <span class="text-3xl" role="img" aria-label={codeLabel(data.current.weatherCode)}>{codeIcon(data.current.weatherCode)}</span>
            </div>
            <div class="mt-2 flex items-end gap-3">
              <span class="font-display text-6xl font-semibold text-goldBright leading-none">
                {Math.round(data.current.temperature)}°C
              </span>
              <div class="pb-1 text-sm">
                <div>{codeLabel(data.current.weatherCode)}</div>
                <div class="text-ivory/60">{w.feelsLike} {Math.round(data.current.apparentTemperature)}°C</div>
              </div>
            </div>

            <!-- Plain-language summary -->
            <p class="mt-3 text-sm text-goldBright/90">{summaryParts.join(' · ')}</p>

            <dl class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center text-sm">
              <div class="rounded-xl bg-ivory/10 p-3">
                <dt class="text-xs text-ivory/60">{w.rainChance}</dt>
                <dd class="font-semibold text-goldBright mt-1">{today?.rainProbability ?? 0}%</dd>
              </div>
              <div class="rounded-xl bg-ivory/10 p-3">
                <dt class="text-xs text-ivory/60">{w.wind}</dt>
                <dd class="font-semibold text-goldBright mt-1">{w.advice.wind[windLevel(data.current.windSpeed)]}</dd>
              </div>
              <div class="rounded-xl bg-ivory/10 p-3">
                <dt class="text-xs text-ivory/60">{w.uvLabel}</dt>
                <dd class="font-semibold text-goldBright mt-1">{w.advice.uv[uvLevel(today?.uvIndexMax ?? data.current.uvIndex)]}</dd>
              </div>
              <div class="rounded-xl bg-ivory/10 p-3">
                <dt class="text-xs text-ivory/60">{w.humidity}</dt>
                <dd class="font-semibold text-goldBright mt-1">{Math.round(data.current.humidity)}%</dd>
              </div>
            </dl>

            <p class="mt-4 text-xs text-ivory/50">{w.updatedLabel} {updated} (ICT)</p>
          </div>
        </div>

        <!-- 7-day forecast -->
        <div class="lg:col-span-7">
          <div class="rounded-2xl bg-teakDeep/70 border border-gold/25 p-6 h-full">
            <span class="text-sm text-ivory/70">{w.forecastLabel}</span>
            <div class="mt-3 grid grid-cols-4 sm:grid-cols-7 gap-2 text-center text-sm">
              {data.daily.map((day) => (
                <div class="rounded-xl bg-ivory/10 p-3 flex flex-col items-center gap-1">
                  <span class="text-xs text-ivory/70">{weekdayFmt.format(toDate(day.date))}</span>
                  <span class="text-[11px] text-ivory/50">{dateFmt.format(toDate(day.date))}</span>
                  <span class="text-2xl" role="img" aria-label={codeLabel(day.weatherCode)}>{codeIcon(day.weatherCode)}</span>
                  <span class="font-semibold text-goldBright">{Math.round(day.tempMax)}°</span>
                  <span class="text-xs text-ivory/60">{Math.round(day.tempMin)}°</span>
                  <span class="text-[11px] text-ivory/60">{w.rainChance} {day.rainProbability ?? 0}%</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Smart advice: risk warnings first, then dynamic groups -->
        <div class="lg:col-span-12">
          <div class="rounded-2xl bg-teakDeep/70 border border-gold/25 p-6">
            <span class="chip text-goldBright border-gold/40">{w.adviceTitle}</span>

            {advice.alerts.length > 0 ? (
              <ul class="mt-4 space-y-2" role="alert">
                {advice.alerts.map((k) => (
                  <li class="flex items-start gap-2.5 rounded-xl bg-red-500/15 border border-red-400/40 px-4 py-3">
                    <span aria-hidden="true">⚠️</span>
                    <span class="text-ivory">{w.advice.alerts[k]}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 flex items-center gap-2.5 rounded-xl bg-emerald-500/10 border border-emerald-400/30 px-4 py-3 text-ivory/90">
                <span aria-hidden="true">✅</span>
                {w.advice.noAlerts}
              </p>
            )}

            {hasAnyGroup && (
              <div class="mt-4 grid md:grid-cols-3 gap-4">
                {groupKeys.map((group) =>
                  advice[group].length > 0 && (
                    <div class="rounded-xl bg-ivory/10 p-4">
                      <h3 class="text-sm font-semibold text-goldBright flex items-center gap-2">
                        <span aria-hidden="true">{groupIcons[group]}</span>
                        {w.advice.labels[group]}
                      </h3>
                      <ul class="mt-2.5 space-y-2 text-sm text-ivory/85">
                        {advice[group].map((k) => (
                          <li class="flex items-start gap-2">
                            <span aria-hidden="true" class="text-goldBright mt-0.5">·</span>
                            <span>{w.advice[group][k]}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div class="mt-10 rounded-2xl border border-gold/25 bg-teakDeep/70 p-8 text-center text-ivory/70">
        {w.unavailable}
      </div>
    )}
  </div>
</section>
