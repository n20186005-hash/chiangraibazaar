---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Footer from '../../../components/Footer.astro';
import { guides } from '../../../data/guides';
import { siteConfig } from '../../../config';
import { attractionDetails } from '../../../data/attractionDetails';
import { topicDetails } from '../../../data/topicDetails';
import { nearbyVisitorFacts } from '../../../data/nearbyVisitorFacts';
import { getI18n, htmlLang, languagesList } from '../../../i18n/ui';
export const prerender = true;
export function getStaticPaths() { return languagesList.flatMap(lang=>guides.map(g=>({params:{lang,slug:g.slug}}))); }
const {lang, messages} = await getI18n(Astro.url);
const guide = guides.find(g=>g.slug===Astro.params.slug)!;
const detail = attractionDetails[guide.slug];
const visitor = nearbyVisitorFacts[guide.slug];
const topic = topicDetails[guide.slug]?.[lang];
const [title,intro,highlight,tip] = guide.copy[lang];
const labels = {
 en:{home:'Home',all:'All guides',about:'About this place or topic',facts:'Visitor essentials',hours:'Hours',cost:'Admission',location:'Location and directions',route:'Suggested visit route',steps:['Before you go','On arrival','Make the most of your stop'],tips:'Things to know',photo:'Photography and observation',stay:'Where to stay',faq:'Frequently asked questions',q1:'When should I visit?',q2:'How do I get there?',answer:'Check the current opening arrangements and weather before travelling. Daytime is usually more appropriate for temples and museums; the bazaar itself is an evening market.',near:'Continue exploring',maps:'Open this place on Google Maps',sources:'Information and updates',sourceText:'Practical guidance is based on the attraction context and publicly available tourism information. Operating arrangements, transport and prices may change; verify at the venue.'},
 zh:{home:'首页',all:'全部攻略',about:'景点与主题介绍',facts:'基本参观信息',hours:'开放时间',cost:'门票费用',location:'位置与交通导航',route:'建议游览路线',steps:['出发前','抵达后','重点体验'],tips:'游览须知',photo:'摄影与观察重点',stay:'住宿建议',faq:'常见问答',q1:'什么时候适合参观？',q2:'如何前往？',answer:'出发前查询开放安排与天气。寺庙和博物馆通常适合白天参观；清莱夜市本身是晚间市集。',near:'继续探索',maps:'在 Google 地图查看此地点',sources:'资料与更新',sourceText:'本页整合景点背景及公开旅游资料。运营安排、交通和价格可能变化，请以现场信息为准。'},
 th:{home:'หน้าแรก',all:'คู่มือทั้งหมด',about:'เกี่ยวกับสถานที่หรือหัวข้อ',facts:'ข้อมูลสำหรับผู้เข้าชม',hours:'เวลาเปิด',cost:'ค่าเข้าชม',location:'ที่ตั้งและการเดินทาง',route:'เส้นทางแนะนำ',steps:['ก่อนออกเดินทาง','เมื่อมาถึง','สิ่งที่ควรสัมผัส'],tips:'ข้อควรรู้',photo:'จุดสังเกตและถ่ายภาพ',stay:'ที่พัก',faq:'คำถามที่พบบ่อย',q1:'ควรไปเมื่อใด?',q2:'เดินทางอย่างไร?',answer:'ตรวจเวลาเปิดและอากาศล่าสุดก่อนเดินทาง วัดและพิพิธภัณฑ์ควรเที่ยวกลางวัน ส่วนไนท์บาซาร์เป็นตลาดตอนเย็น',near:'เที่ยวต่อ',maps:'เปิดสถานที่นี้ใน Google Maps',sources:'ข้อมูลและการอัปเดต',sourceText:'คำแนะนำเรียบเรียงจากข้อมูลการท่องเที่ยวสาธารณะ เวลาเปิด การเดินทาง และราคาอาจเปลี่ยนได้ ควรตรวจหน้างาน'}
}[lang];
const maps = guide.place ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(nearbyVisitorFacts[guide.slug]?.address ?? guide.place+', Chiang Rai Thailand')}` : siteConfig.mapsUrl;
const isNightMarket = !guide.place;
const related = guides.filter(g=>g.slug!==guide.slug && (g.category===guide.category || g.category==='nearby')).slice(0,5);
const managementTitle = {en:'About the attraction and its stewardship',zh:'关于景点与管理主体',th:'เกี่ยวกับสถานที่และหน่วยงานดูแล'}[lang];
const managementMarket = {en:'Chiang Rai Night Bazaar consists of individual merchants and food vendors in a central-city market area. Stall services are operated by their respective businesses; for current public-space arrangements and event details, consult the local municipal tourism office.',zh:'清莱夜市由市中心的独立商贩与餐饮摊位组成，各摊位自行经营。公共空间安排及活动信息，可向清莱当地市政旅游部门查询。',th:'เชียงรายไนท์บาซาร์ประกอบด้วยผู้ค้าและร้านอาหารหลายรายที่ดำเนินกิจการของตนเอง สำหรับข้อมูลพื้นที่สาธารณะและกิจกรรมล่าสุดควรติดต่อหน่วยงานท่องเที่ยวของเทศบาล'}[lang];
const photoAllowed = ['clock-tower','wat-jed-yod','wat-phra-kaew','wat-phra-singh','blue-temple','white-temple','baandam-museum','singha-park','saturday-walking-street','sunday-happy-street'];
const photoSrc = detail && photoAllowed.includes(guide.slug) ? detail.photo : undefined;
const moreLabel = {en:['Historical and cultural context','Architecture and what to notice','Suggested observation and photography','Getting there','Start from the city centre and use the destination-specific map pin; allow extra time for traffic and a separate return journey.'],zh:['历史与文化背景','建筑特色与观察重点','摄影机位与游览建议','交通方式','从清莱市中心出发，使用本景点专属地图定位；考虑路况并预留返程时间。'],th:['ประวัติและวัฒนธรรม','สถาปัตยกรรมและจุดสังเกต','การชมและถ่ายภาพ','การเดินทาง','เริ่มจากใจกลางเชียงราย ใช้หมุดแผนที่เฉพาะสถานที่ และเผื่อเวลาเดินทางกลับ']}[lang];
const visitorHead = {en:{explore:'Explore this destination',advice:'Before you visit',highlights:'What makes it special',hours:'Opening and visit times',ticket:'Tickets and costs',transport:'How to get there',photo:'Photo locations',reviews:'Visitor feedback',reviewText:'Read current visitor feedback on the destination’s own Google Maps listing. Ratings and review counts are not copied here because they change.',rating:'Google Maps reviews',address:'Full location / street address',type:'Type of attraction',route:'On-site walking route'},zh:{explore:'探索这处景点',advice:'游览建议',highlights:'景区特色',hours:'开放时间与游览时段',ticket:'门票与消费',transport:'交通方式',photo:'推荐拍摄机位',reviews:'游客评价',reviewText:'可通过本景点专属 Google 地图页面查看近期游客评价。评分和评论数量会持续变化，因此这里不展示未经同步的数字。',rating:'Google 地图游客评价',address:'具体地址／道路位置',type:'景点类型',route:'景点内步行路线'},th:{explore:'สำรวจสถานที่',advice:'คำแนะนำก่อนเที่ยว',highlights:'จุดเด่น',hours:'เวลาเปิดและช่วงเที่ยว',ticket:'บัตรเข้าและค่าใช้จ่าย',transport:'วิธีเดินทาง',photo:'จุดถ่ายภาพ',reviews:'รีวิวผู้เข้าชม',reviewText:'อ่านรีวิวล่าสุดจากหน้าสถานที่นี้โดยตรงบน Google Maps ไม่แสดงคะแนนหรือจำนวนรีวิวที่ไม่ได้อัปเดต',rating:'รีวิว Google Maps',address:'ที่อยู่ / ถนน',type:'ประเภทสถานที่',route:'เส้นทางเดินชม'}}[lang];
---
<BaseLayout lang={lang} title={`${title} | Chiang Rai Night Bazaar`} description={intro} guidePage>
  <header class="bg-teakDeep text-ivory border-b border-gold/30"><div class="max-w-6xl mx-auto px-5 py-5 flex flex-wrap items-center justify-between gap-4"><a href={`/${lang}/`} class="text-goldBright font-display text-xl">{messages.footer.brand.name}</a><nav class="flex flex-wrap gap-4 text-sm"><a href={`/${lang}/`}>{labels.home}</a><a href={`/${lang}/guides/`}>{labels.all}</a>{languagesList.map(l=><a hreflang={htmlLang[l]} class={l===lang?'text-goldBright':''} href={`/${l}/guides/${guide.slug}/`}>{l.toUpperCase()}</a>)}</nav></div></header>
  <main>
    <section class="bg-teak text-ivory py-16"><div class="max-w-6xl mx-auto px-5 grid md:grid-cols-[1.5fr_1fr] gap-10 items-center"><div><p class="text-gold text-xs uppercase tracking-widest">Chiang Rai · {visitor?.kind[lang] ?? guide.category}</p><h1 class="font-display text-4xl md:text-5xl max-w-4xl mt-4">{title}</h1><p class="mt-5 text-lg text-ivory/80 max-w-3xl">{intro}</p><p class="text-goldBright mt-4 text-sm">{visitor?.hours[lang] ?? (isNightMarket ? siteConfig.hours[lang] : (lang==='zh'?'开放与票价请查询景点现场公告':lang==='th'?'ตรวจเวลาเปิดและค่าเข้าชมจากสถานที่':'Check venue hours and admission locally'))}</p><div class="flex flex-wrap gap-3 mt-8"><a href={maps} target="_blank" rel="noopener noreferrer" class="bg-gold text-teak font-semibold px-5 py-3 rounded-full">{labels.maps} ↗</a><a href={`/${lang}/guides/`} class="border border-gold/50 px-5 py-3 rounded-full">{labels.all}</a></div></div>{(photoSrc || isNightMarket) && <img loading="eager" src={photoSrc ?? '/gallery/chiang-rai-night-bazaar-1.jpg'} alt={title} class="rounded-xl shadow-xl w-full h-72 object-cover"/>}</div></section>
    <div class="max-w-6xl mx-auto px-5 py-12 grid lg:grid-cols-[2fr_1fr] gap-12">
      <article class="space-y-11">
        <section><h2 class="font-display text-3xl mb-4">{labels.about}</h2><p>{intro}</p><p class="mt-4">{highlight}</p></section>
        {visitor && <section class="space-y-5"><h2 class="font-display text-3xl">{visitorHead.explore}</h2><p>{intro}</p><h3 class="font-display text-xl text-burgundy">{visitorHead.advice}</h3><p>{visitor.visit[lang]}</p><h3 class="font-display text-xl text-burgundy">{visitorHead.highlights}</h3><p>{detail?.features[lang][0]}</p></section>}
        {topic && <section class="space-y-5"><h2 class="font-display text-3xl">{lang==='zh'?'深入体验与实用建议':lang==='th'?'ข้อมูลเชิงลึกและเคล็ดลับ':'In-depth visitor insight'}</h2>{topic.map(p=><p>{p}</p>)}</section>}
        <section class="rounded-xl bg-white border-l-4 border-gold p-7"><h2 class="font-display text-3xl mb-4">{managementTitle}</h2><p>{detail?.management[lang] ?? managementMarket}</p><p class="mt-4">{detail?.features[lang][0] ?? intro}</p></section>
        {detail && <section><h2 class="font-display text-3xl mb-5">{lang==='zh'?'发现景点魅力':lang==='th'?'เสน่ห์ของสถานที่':'Discover the attraction'}</h2><div class="space-y-7">{detail.features[lang].map((paragraph,i)=><div><h3 class="font-display text-xl text-burgundy mb-2">{moreLabel[i]}</h3><p>{paragraph}</p></div>)}</div></section>}
        <section class="rounded-xl bg-white border border-gold/30 p-7"><h2 class="font-display text-2xl mb-4">{labels.facts}</h2><dl class="grid sm:grid-cols-2 gap-5">{visitor && <><div><dt class="text-sm text-burgundy">{visitorHead.type}</dt><dd class="mt-1">{visitor.kind[lang]}</dd></div><div><dt class="text-sm text-burgundy">{visitorHead.address}</dt><dd class="mt-1">{visitor.address}</dd></div></>}<div><dt class="text-sm text-burgundy">{labels.location}</dt><dd class="mt-1">{guide.place ?? siteConfig.address[lang]}</dd></div><div><dt class="text-sm text-burgundy">{labels.hours}</dt><dd class="mt-1">{visitor?.hours[lang] ?? (isNightMarket ? siteConfig.hours[lang] : labels.answer)}</dd></div><div><dt class="text-sm text-burgundy">{labels.cost}</dt><dd class="mt-1">{visitor?.admission[lang] ?? (isNightMarket ? (lang==='zh'?'免费入场，消费自理':lang==='th'?'เข้าฟรี จ่ายค่าสินค้าเอง':'Free entry; purchases extra') : (lang==='zh'?'请核实景点最新票务':lang==='th'?'ตรวจค่าเข้าชมล่าสุด':'Check current venue admission'))}</dd></div><div><dt class="text-sm text-burgundy">Google Maps</dt><dd class="mt-1"><a class="underline text-burgundy" href={maps} target="_blank" rel="noopener">{labels.maps}</a></dd></div></dl></section>
        {visitor && <section class="space-y-5"><h2 class="font-display text-3xl">{visitorHead.hours}</h2><p>{visitor.hours[lang]}</p><h2 class="font-display text-3xl">{visitorHead.ticket}</h2><p>{visitor.admission[lang]}</p><h2 class="font-display text-3xl">{visitorHead.transport}</h2><p>{visitor.access[lang]}</p></section>}
        <section><h2 class="font-display text-3xl mb-5">{labels.route}</h2><ol class="space-y-5">{[labels.steps[0],labels.steps[1],labels.steps[2]].map((s,i)=><li class="flex gap-4"><span class="bg-teak text-gold rounded-full w-10 h-10 shrink-0 flex items-center justify-center font-semibold">{i+1}</span><div><h3 class="font-semibold text-lg">{s}</h3><p>{[tip,intro,highlight][i]}</p></div></li>)}</ol></section>
        {visitor && <section><h2 class="font-display text-2xl mb-3">{visitorHead.route}</h2><p>{visitor.visit[lang]}</p></section>}
        <section><h2 class="font-display text-3xl mb-4">{moreLabel[3]}</h2><p>{visitor?.access[lang] ?? (guide.place ? moreLabel[4] : tip)}</p><div class="rounded-xl overflow-hidden mt-5 border border-gold/30"><iframe title={`${title} Google Maps`} src={`https://maps.google.com/maps?q=${encodeURIComponent(visitor?.address ?? (guide.place ? guide.place+', Chiang Rai, Thailand' : 'Chiang Rai Night Bazaar, Chiang Rai, Thailand'))}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="w-full h-72" ></iframe></div><p class="mt-3"><a class="text-burgundy underline" href={maps} target="_blank" rel="noopener noreferrer">{labels.maps} ↗</a></p></section>
        <section><h2 class="font-display text-3xl mb-4">{labels.tips}</h2><p>{tip}</p><p class="mt-4">{labels.answer}</p></section>
        <section><h2 class="font-display text-3xl mb-4">{labels.photo}</h2><p>{detail?.features[lang][2] ?? highlight}</p>{visitor && <p class="mt-3">{visitorHead.photo}：{visitor.photo[lang]}</p>}{(photoSrc || isNightMarket) && <figure class="mt-5"><img loading="lazy" src={photoSrc ?? '/gallery/chiang-rai-night-bazaar-3.jpg'} alt={title} class="rounded-xl w-full max-h-96 object-cover"/><figcaption class="text-sm text-ink/60 mt-2">{title}</figcaption></figure>}</section>
        <section><h2 class="font-display text-3xl mb-4">{labels.stay}</h2><p>{lang==='zh'?'住在清莱市中心第一巴士站或钟楼附近，方便步行前往夜市。若计划前往市郊景点，提前安排交通与次日出发地点。':lang==='th'?'ที่พักใกล้สถานีขนส่งแห่งที่ 1 หรือหอนาฬิกาเหมาะกับการเดินไปตลาด หากไปแหล่งท่องเที่ยวนอกเมืองควรวางแผนรถล่วงหน้า':'Staying near Bus Terminal 1 or the Clock Tower makes an evening market visit convenient on foot. Plan transport separately for sights outside central Chiang Rai.'}</p></section>
        <section><h2 class="font-display text-3xl mb-5">{labels.faq}</h2><h3 class="font-semibold">{labels.q1}</h3><p class="mt-2">{visitor?.hours[lang] ?? labels.answer}</p><h3 class="font-semibold mt-5">{labels.q2}</h3><p class="mt-2">{visitor?.access[lang] ?? tip} <a href={maps} class="underline text-burgundy" target="_blank" rel="noopener">Google Maps ↗</a></p></section>
        {visitor && <section><h2 class="font-display text-3xl mb-3">{visitorHead.reviews}</h2><p>{visitorHead.reviewText}</p><a class="inline-block mt-3 underline text-burgundy" href={maps} target="_blank" rel="noopener noreferrer">{visitorHead.rating} ↗</a></section>}
        <section class="border-t border-gold/40 pt-7"><h2 class="font-display text-2xl mb-3">{labels.sources}</h2><p class="text-sm">{labels.sourceText}</p><a class="text-burgundy underline text-sm" target="_blank" rel="noopener" href="https://www.tourismthailand.org">Tourism Authority of Thailand ↗</a>{photoSrc && detail?.source && <p class="text-sm mt-3"><a class="underline text-burgundy" href={detail.source} target="_blank" rel="noopener noreferrer">{lang==='zh'?'实景照片出处':lang==='th'?'แหล่งภาพสถานที่':'Photograph source'} ↗</a></p>}</section>
      </article>
      <aside><div class="lg:sticky lg:top-6 rounded-xl bg-white border border-gold/30 p-6"><h2 class="font-display text-2xl mb-4">{labels.near}</h2><ul class="space-y-3">{related.map(g=><li><a class="text-burgundy hover:underline" href={`/${lang}/guides/${g.slug}/`}>{g.copy[lang][0]} →</a></li>)}</ul></div></aside>
    </div>
  </main>
  <Footer lang={lang} messages={messages}/>
</BaseLayout>
