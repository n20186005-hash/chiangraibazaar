---
import { defaultLang, languagesList, getI18n } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Weather from '../../components/Weather.astro';
import About from '../../components/About.astro';
import History from '../../components/History.astro';
import Guide from '../../components/Guide.astro';
import Markets from '../../components/Markets.astro';
import SeasonalStrategy from '../../components/SeasonalStrategy.astro';
import Itineraries from '../../components/Itineraries.astro';
import Food from '../../components/Food.astro';
import CultureShow from '../../components/CultureShow.astro';
import Nearby from '../../components/Nearby.astro';
import Tips from '../../components/Tips.astro';
import Services from '../../components/Services.astro';
import Stewardship from '../../components/Stewardship.astro';
import Gallery from '../../components/Gallery.astro';
import Reviews from '../../components/Reviews.astro';
import FAQ from '../../components/FAQ.astro';
import MapSection from '../../components/MapSection.astro';
import Footer from '../../components/Footer.astro';
import GuideDirectory from '../../components/GuideDirectory.astro';
import NearbyDirectory from '../../components/NearbyDirectory.astro';

// Server-rendered page (weather module fetches fresh data on the server).
// Unknown language prefixes are redirected to the default locale.
const firstSegment = Astro.url.pathname.split('/').filter(Boolean)[0];
if (!languagesList.includes(firstSegment)) {
  return Astro.redirect(`/${defaultLang}/`, 302);
}
const { lang, messages } = await getI18n(Astro.url);
---

<BaseLayout lang={lang} title={messages.meta.title} description={messages.meta.description}>
  <Header lang={lang} messages={messages} />
  <main>
    <Hero lang={lang} messages={messages} />
    <Weather lang={lang} messages={messages} />
    <About messages={messages} />
    <History messages={messages} />
    <Guide messages={messages} />
    <Markets messages={messages} />
    <SeasonalStrategy lang={lang} messages={messages} />
    <Itineraries lang={lang} messages={messages} />
    <Food messages={messages} />
    <CultureShow messages={messages} />
    <Nearby messages={messages} />
    <Tips messages={messages} />
    <Services lang={lang} messages={messages} />
    <Stewardship lang={lang} messages={messages} />
    <Gallery messages={messages} />
    <Reviews messages={messages} />
    <FAQ messages={messages} />
    <MapSection lang={lang} messages={messages} />
    <NearbyDirectory lang={lang} />
    <GuideDirectory lang={lang} />
  </main>
  <Footer lang={lang} messages={messages} />
</BaseLayout>
