{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiangrai-night-bazaar",
  "compatibility_date": "2026-09-01",
  "main": "dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
